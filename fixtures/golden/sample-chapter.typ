  smallcaps(it.body)
})
#show heading.where(level: 3): it => block(width: 100%, above: 1.5em, below: 0.75em, sticky: true, {
  set align(left)
  set text(font: "Libertinus Serif", size: 1em, weight: "regular", style: "italic")
