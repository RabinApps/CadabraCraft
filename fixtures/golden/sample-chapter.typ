// Generated by @cadabracraft/export-pdf. Template: novel. Do not edit by hand.
#let book-title = "Sample Book"
#set document(title: book-title, author: "Test Author")
#let mark(name, info: none) = [#metadata(info)#label(name)]
#let chapter-pages() = query(<chapter-start>).map(m => m.location().page())
#let chapter-end-pages() = query(<chapter-end>).map(m => m.location().page())
#let is-blank(pg) = (pg + 1) in chapter-pages() and not (pg in chapter-end-pages()) and not (pg in chapter-pages())
// Pages between a pair of start/end marks (title and copyright pages show no header or number; dedications show no header).
#let marked-pages(a, b) = query(label(a)).map(m => m.location().page()).zip(query(label(b)).map(m => m.location().page())).map(((x, y)) => range(x, y + 1)).flatten()
#let no-folio-pages() = marked-pages("folio-off-start", "folio-off-end")
#let no-header-pages() = no-folio-pages() + marked-pages("header-off-start", "header-off-end")
#set page(width: 5.5in, height: 8.5in, margin: (top: 0.8in, bottom: 0.9in, inside: 0.9in, outside: 0.65in),
  header: context {
    let pg = here().page()
    if is-blank(pg) or pg in chapter-pages() or pg in no-header-pages() { return }
    set text(size: 9pt)
    if calc.odd(pg) { align(right, smallcaps(state("chapter-title").get())) } else { align(left, smallcaps(book-title)) }
  },
  footer: context {
    if is-blank(here().page()) or here().page() in no-folio-pages() { return }
    set text(size: 9pt)
    align(center, counter(page).display())
  })
#set text(font: "Libertinus Serif", size: 11pt, hyphenate: true, lang: "en")
#set par(justify: true, leading: 0.62em, spacing: 0.62em, first-line-indent: (amount: 1.4em, all: false))
#show heading.where(level: 1): it => block(width: 100%, above: 0pt, below: 2.2em, sticky: true, {
  set align(center)
  set text(font: "Libertinus Serif", size: 1.7em, weight: "regular", style: "normal")
  set par(first-line-indent: 0pt, justify: false, hanging-indent: 0pt)
  it.body
})
#show heading.where(level: 2): it => block(width: 100%, above: 2em, below: 1em, sticky: true, {
  set align(center)
  set text(font: "Libertinus Serif", size: 1.2em, weight: "regular", style: "normal")
  set par(first-line-indent: 0pt, justify: false, hanging-indent: 0pt)
  smallcaps(it.body)
})
#show heading.where(level: 3): it => block(width: 100%, above: 1.5em, below: 0.75em, sticky: true, {
  set align(left)
  set text(font: "Libertinus Serif", size: 1em, weight: "regular", style: "italic")
  set par(first-line-indent: 0pt, justify: false, hanging-indent: 0pt)
  it.body
})
#show quote.where(block: true): it => block(width: 100%, above: 0.8em, below: 0.8em, inset: (left: 1.5em, right: 1.5em), {
  set text(size: 0.95em, style: "normal")
  set par(first-line-indent: 0pt)
  it.body
})
#show list: set par(first-line-indent: 0pt)
#show enum: set par(first-line-indent: 0pt)
#set list(indent: 0.8em, body-indent: 0.6em)
#set enum(indent: 0.8em, body-indent: 0.6em)
#set table(stroke: 0.5pt + luma(120), inset: 0.5em)
#show table: set text(size: 0.9em)
#show table: set par(first-line-indent: 0pt, justify: false)
#show table: set block(above: 1.2em, below: 1.2em)
#show raw: set text(size: 0.9em)
#show raw.where(block: true): set par(first-line-indent: 0pt, justify: false)
#show raw.where(block: true): set block(above: 1em, below: 1em, breakable: true)
#show footnote.entry: set text(size: 0.85em)
#show footnote.entry: set par(first-line-indent: 0pt, justify: false)
#show figure: set block(above: 1.2em, below: 1.2em)
#show figure.caption: it => text(size: 0.85em, it.body)
#let fit-image(path, alt, max-height) = layout(size => {
  let img = image(path, width: size.width, alt: alt)
  let out = if measure(img).height > max-height { image(path, height: max-height, alt: alt) } else { img }
  // No alt text means decorative: PDF/UA rejects an untagged image, so mark it as an artifact.
  if alt == none { pdf.artifact(out) } else { out }
})
#let task-box(checked) = box(width: 0.7em, height: 0.7em, baseline: 0.05em, stroke: 0.6pt, {
  if checked {
    place(line(start: (15%, 55%), end: (40%, 85%), stroke: 0.8pt))
    place(line(start: (40%, 85%), end: (90%, 15%), stroke: 0.8pt))
  }
})
#let def-term(body) = block(above: 0.9em, below: 0.3em, sticky: true, strong(body))
#let def-desc(body) = block(above: 0.3em, below: 0.3em, pad(left: 1.5em, {
  set par(first-line-indent: 0pt)
  body
}))
#let scene-break() = align(center, block(above: 1em, below: 1em, "*   *   *"))
#let chapter-start(title, n, id: "", kind: "chapter") = {
  pagebreak(weak: true, to: "odd")
  mark("chapter-start", info: (id: id, kind: kind))
  state("chapter-title").update(title)
  counter(footnote).update(0)
  v(8em)
  align(center, text(size: 1.2em, "⁂"))
  v(0.6em)
}
// Front and back matter pages with their own layout. The marks sit inside the aligned block so they stay on the page they describe.
#let matter-marks(id, kind, start, end, body) = {
  mark("chapter-start", info: (id: id, kind: kind))
  mark(start)
  body
  mark(end)
  mark("chapter-end")
}
#let title-page(id, kind, body, centre: true) = {
  pagebreak(weak: true)
  align(center + if centre { horizon } else { top }, matter-marks(id, kind, "folio-off-start", "folio-off-end", {
    show heading: it => block(width: 100%, below: 1em, text(font: "Libertinus Serif", size: if it.level == 1 { 1.9em } else { 1.1em }, weight: "bold", it.body))
    set par(first-line-indent: 0pt, justify: false)
    set text(size: 1.25em)
    body
  }))
}
#let copyright-page(id, kind, body) = {
  pagebreak(weak: true)
  align(bottom, block(width: 100%, matter-marks(id, kind, "folio-off-start", "folio-off-end", {
    set text(size: 0.85em)
    set par(first-line-indent: 0pt, justify: false, spacing: 0.7em)
    body
  })))
}
#let centered-page(id, kind, body, centre: true) = {
  pagebreak(weak: true)
  align(center + if centre { horizon } else { top }, block(width: 78%, matter-marks(id, kind, "header-off-start", "header-off-end", {
    set par(first-line-indent: 0pt, justify: false)
    body
  })))
}

