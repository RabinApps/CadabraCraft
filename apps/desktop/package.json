{
  "name": "@cadabracraft/desktop",
  "license": "SEE LICENSE IN LICENSE",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "tauri": "tauri",
    "typecheck": "tsc -p tsconfig.json",
    "i18n:extract": "lingui extract --clean",
    "i18n:check": "lingui extract --clean && git diff --exit-code src/i18n/locales",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "playwright test",
    "screenshots:website": "playwright test -c playwright.screenshots.config.ts",
    "test:e2e:webkit": "WEBKIT=1 playwright test --project=webkit",
    "test:a11y": "playwright test a11y language-mark images.spec",
    "test:a11y:locales": "E2E_LOCALES=1 playwright test --project=locale-he --project=locale-ar --project=locale-pseudo --project=locale-pseudo-rtl",
    "build:native": "tauri build --debug --no-bundle --features dev-automation",
    "test:native": "vitest run --config e2e-native/vitest.config.ts",
    "test:e2e:webdriver": "pnpm test:native",
    "tauri:automate": "tauri dev --features dev-automation --config src-tauri/tauri.automation.conf.json",
    "test:e2e:coverage": "COVERAGE=1 playwright test",
    "e2e:map": "COVERAGE=1 SPEC_MAP=only playwright test",
    "test:voiceover": "playwright test --config e2e-voiceover/playwright.config.ts"
  },
  "dependencies": {
    "@cadabracraft/editor-schema": "workspace:*",
    "@cadabracraft/export-audio": "workspace:*",
    "@cadabracraft/export-docx": "workspace:*",
    "@cadabracraft/export-epub": "workspace:*",
    "@cadabracraft/export-markdown": "workspace:*",
    "@cadabracraft/outline": "workspace:*",
    "@cadabracraft/export-pdf": "workspace:*",
    "@cadabracraft/export-rtf": "workspace:*",
    "@cadabracraft/format": "workspace:*",
    "@cadabracraft/import-docx": "workspace:*",
    "@cadabracraft/shared": "workspace:*",
    "@cadabracraft/story-structures": "workspace:*",
    "@cadabracraft/templates": "workspace:*",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@lingui/core": "^6.12.0",
    "@lingui/react": "^6.12.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-toggle-group": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tailwindcss/vite": "^4.3.5",
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-opener": "^2.7.3",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "@tiptap/pm": "^3.34.0",
    "@tiptap/react": "^3.34.0",
    "lucide-react": "^1.73.0",
    "pdfjs-dist": "6.5.438",
    "re2js": "2.10.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@babel/core": "^8.1.2",
    "@guidepup/guidepup": "^0.40.0",
    "@guidepup/playwright": "^0.21.0",
    "@guidepup/virtual-screen-reader": "^0.33.0",
    "@lingui/babel-plugin-lingui-macro": "^6.12.0",
    "@lingui/cli": "^6.12.0",
    "@lingui/conf": "^6.12.0",
    "@lingui/format-po": "^6.12.0",
    "@lingui/vite-plugin": "^6.12.0",
    "@playwright/test": "^1.65.1",
    "@rolldown/plugin-babel": "^0.3.1",
    "@tauri-apps/cli": "^2.12.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/selenium-webdriver": "^4.35.7",
    "@vitejs/plugin-react": "^6.3.0",
    "accessibility-checker-engine": "^4.0.35",
    "fflate": "^0.8.3",
    "html_codesniffer": "^2.5.1",
    "monocart-coverage-reports": "^3.2.1",
    "selenium-webdriver": "^4.52.0",
    "vite": "^8.3.8"
  }
}
