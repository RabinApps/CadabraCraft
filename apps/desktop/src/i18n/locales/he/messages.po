#: src/app/shell/native/quit.ts
msgid "Your last changes could not be saved ({message}). Close the window again to leave without them, or free some space and try again."
msgstr "לא ניתן היה לשמור את השינויים האחרונים שלכם ({message}). סגרו שוב את החלון כדי לצאת בלעדיהם, או פנו מקום ונסו שוב."

#: src/app/shell/ErrorBoundary.tsx
msgid "Your last changes were saved if possible. Choose Reload to open the app again. If this keeps happening, restart CadabraCraft; your books are in their folders, and earlier versions are in History."
msgstr "השינויים האחרונים שלכם נשמרו אם היה אפשר. בחרו \"טעינה מחדש\" כדי לפתוח את האפליקציה שוב. אם זה ממשיך, הפעילו מחדש את CadabraCraft; הספרים שלכם בתיקיות שלהם, וגרסאות קודמות בהיסטוריה."

#: src/app/hooks/appMenuCommands.ts
