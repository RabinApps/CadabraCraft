{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CadabraCraft",
  "version": "0.1.0",
  "identifier": "com.cadabracraft.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "CadabraCraft",
        "width": 1000,
        "height": 800,
        "minWidth": 400
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' blob: data:",
        "font-src": "'self' data:",
        "media-src": "'self' blob: cadabra-ref: http://cadabra-ref.localhost",
        "worker-src": "'self' blob:",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-src": "https://support.cadabracraft.com"
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self' 'unsafe-inline' http://localhost:1420",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' blob: data: http://localhost:1420",
        "font-src": "'self' data: http://localhost:1420",
        "media-src": "'self' blob: cadabra-ref: http://cadabra-ref.localhost",
        "connect-src": "'self' ipc: http://ipc.localhost http://localhost:1420 ws://localhost:1420",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-src": "https://support.cadabracraft.com"
      },
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "appimage"],
    "icon": ["icons/icon.icns", "icons/icon.ico", "icons/icon.png"],
    "externalBin": ["binaries/typst", "binaries/sherpa-onnx-offline-tts", "binaries/ffmpeg"],
    "resources": { "binaries/fonts/*": "fonts/", "binaries/epubcheck": "epubcheck", "binaries/jre": "jre", "binaries/licenses/*": "licenses/", "licenses/*": "licenses/", "../../../LICENSE": "licenses/LICENSE.txt", "../../../NOTICE": "licenses/NOTICE.txt", "../../../LICENSE-CLARIFICATIONS.md": "licenses/LICENSE-CLARIFICATIONS.md" },
    "macOS": {
      "signingIdentity": null,
      "hardenedRuntime": true
    },
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" },
      "nsis": { "languages": ["English", "Spanish", "Italian", "French", "German", "Hebrew", "Arabic"] }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRGNkNDMjk1NDVFMkJEMjkKUldRcHZlSkZsY0pzVDg0Vm14c2R2VzBnK0VkNVpPSU93SENkbi9JMnYyMHZPcDZXQU9DdktRSGgK",
      "endpoints": ["https://github.com/RabinApps/cadabracraft/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
