<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Entitlements for the bundled Java runtime's executables only (bin/java, lib/jspawnhelper), applied by
     scripts/sign-jre.sh. Not used for the app itself. The HotSpot JIT writes and runs generated code, which the
     hardened runtime blocks without these two. Library validation stays on: every dylib in the runtime is signed
     with the same Developer ID as the launcher, so no disable-library-validation. -->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
</dict>
</plist>
