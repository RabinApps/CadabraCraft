                        {
                          "type": "text",
                          "id": "jR9D1",
                          "name": "By the time Ines reached",
                          "fill": "$ink",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "By the time Ines reached the wall, the apples had begun to fall, thudding into the long grass like small, unhurried knocks.",
                          "lineHeight": 1.65,
                          "fontFamily": "$font-book",
                          "fontSize": 19,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
                          "id": "l9kVvc",
                          "name": "She had been told the or",
                          "fill": "$ink",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "She had been told the orchard belonged to no one. Nothing about the gate, rusted open and wound with bindweed, suggested otherwise.",
                          "lineHeight": 1.65,
                          "fontFamily": "$font-book",
                          "fontSize": 19,
                          "fontWeight": "normal"
                        },
