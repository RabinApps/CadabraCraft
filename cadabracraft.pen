                  "width": "fill_container",
                  "content": "* * *",
                  "textAlign": "center",
                  "fontFamily": "$font-book",
                  "fontSize": 20,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "S9zjoi",
                  "name": "In the morning the salt ",
                  "fill": "$ink",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "In the morning the salt came in off the water, and with it the smell of something older than the harbour. Ines woke to the sound of a ladder being dragged across gravel, and lay very still, counting the seconds between each scrape.",
                  "lineHeight": 1.75,
                  "fontFamily": "$font-book",
                  "fontSize": 20,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "mch8u",
                  "name": "Somebody, it seemed, had",
                  "fill": "$ink",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Somebody, it seemed, had been told otherwise.",
                  "lineHeight": 1.75,
                  "fontFamily": "$font-book",
                  "fontSize": 20,
                  "fontWeight": "normal"
                }
              ]
            }
