                          "textAlign": "center",
                          "fontFamily": "$font-book",
                          "fontSize": 18,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
                          "id": "L7q9No",
                          "name": "In the morning the salt ",
                          "fill": "$ink",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "In the morning the salt came in off the water, and with it the smell of something older than the harbour.",
                          "lineHeight": 1.65,
                          "fontFamily": "$font-book",
                          "fontSize": 19,
                          "fontWeight": "normal"
                        }
                      ]
