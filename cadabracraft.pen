                                      "layout": "vertical",
                                      "children": [
                                        {
                                          "type": "frame",
                                          "id": "z2YUJn",
                                          "name": "Chapter opening (sunk)",
                                          "width": "fill_container",
                                          "layout": "vertical",
                                          "gap": 10,
                                          "padding": [
                                            80,
