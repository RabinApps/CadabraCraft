                                  "children": [
                                    {
                                      "type": "frame",
                                      "id": "uUFg1",
                                      "x": 66,
                                      "y": 59,
                                      "name": "Text block",
                                      "clip": true,
                                      "width": 326,
                                      "height": 535,
                                      "layout": "vertical",
                                      "children": [
                                        {
                                          "type": "frame",
                                          "id": "qs2qW",
                                          "name": "Chapter opening (sunk)",
                                          "width": "fill_container",
                                          "layout": "vertical",
                                          "gap": 9,
                                          "padding": [
                                            73,
                                            0,
                                            29,
                                            0
                                          ],
                                          "alignItems": "center",
                                          "children": [
                                            {
                                              "type": "text",
                                              "id": "fJb1x",
                                              "name": "Chapter number",
                                              "fill": "$ink-muted",
                                              "content": "CHAPTER SEVEN",
                                              "fontFamily": "$font-book",
                                              "fontSize": 8.1,
                                              "fontWeight": "normal",
                                              "letterSpacing": 2
                                            },
                                            {
                                              "type": "text",
                                              "id": "lTAJH",
                                              "name": "Chapter title",
                                              "fill": "$ink",
                                              "textGrowth": "fixed-width",
                                              "width": "fill_container",
                                              "content": "The Orchard Wall",
                                              "textAlign": "center",
                                              "fontFamily": "$font-book",
                                              "fontSize": 22.4,
                                              "fontWeight": "600"
                                            }
                                          ]
                                        },
                                        {
                                          "type": "text",
                                          "id": "azH0b",
                                          "name": "Paragraph",
                                          "fill": "$ink",
                                          "textGrowth": "fixed-width",
                                          "width": "fill_container",
                                          "content": "By the time Ines reached the wall, the apples had begun to fall, thudding into the long grass like small, unhurried knocks.",
                                          "lineHeight": 1.4,
                                          "textAlign": "justify",
                                          "fontFamily": "$font-book",
                                          "fontSize": 11.2,
                                          "fontWeight": "normal"
                                        },
                                        {
                                          "type": "text",
                                          "id": "Ev4Pk",
                                          "name": "Paragraph",
                                          "fill": "$ink",
                                          "textGrowth": "fixed-width",
                                          "width": "fill_container",
                                          "content": "​　　 She had been told the orchard belonged to no one. Nothing about the gate, rusted open and wound with bindweed, suggested otherwise.",
                                          "lineHeight": 1.4,
                                          "textAlign": "justify",
                                          "fontFamily": "$font-book",
                                          "fontSize": 11.2,
                                          "fontWeight": "normal"
                                        },
                                        {
                                          "type": "text",
                                          "id": "je9Ff",
                                          "name": "Paragraph",
                                          "fill": "$ink",
                                          "textGrowth": "fixed-width",
                                          "width": "fill_container",
                                          "content": "​　　 Beyond it the trees stood in rows that had once been straight. Salt had stunted them, wind had leaned them all one way, and the grass between them had grown thick enough to hide a path, if there had ever been one.",
                                          "lineHeight": 1.4,
                                          "textAlign": "justify",
                                          "fontFamily": "$font-book",
                                          "fontSize": 11.2,
                                          "fontWeight": "normal"
                                        },
                                        {
                                          "type": "text",
                                          "id": "NkWjv",
                                          "name": "Paragraph",
                                          "fill": "$ink",
                                          "textGrowth": "fixed-width",
                                          "width": "fill_container",
                                          "content": "​　　 She stood a while with her hand on the stones. They were warm, and rough with lichen, and somewhere on the far side a bird she could not name went on repeating the same four notes, as if it had lost the rest of the song and meant to go on asking for it.",
                                          "lineHeight": 1.4,
                                          "textAlign": "justify",
                                          "fontFamily": "$font-book",
                                          "fontSize": 11.2,
                                          "fontWeight": "normal"
                                        },
                                        {
                                          "type": "text",
                                          "id": "hKWeG",
                                          "name": "Paragraph",
                                          "fill": "$ink",
                                          "textGrowth": "fixed-width",
                                          "width": "fill_container",
                                          "content": "​　　 Her aunt had said not to go past the wall. She had not said why, and Ines had learned that her aunt's silences were not empty but full, like the cellar at the end of winter, and best left with the door shut. Still, the gate was open, and the apples were falling, and no one had ever told her what to do with an afternoon this long. She put one foot on the lowest stone and then the other, and the wall, which had looked so much taller from the road, let her up without complaint. From the top she could see the whole orchard laid out below her, and beyond it the grey line of the water, and a single roof, very small, with no smoke coming from the chimney. The wind had dropped. Somewhere below her a branch let go of",
                                          "lineHeight": 1.4,
                                          "textAlign": "justify",
                                          "fontFamily": "$font-book",
                                          "fontSize": 11.2,
                                          "fontWeight": "normal"
                                        }
                                      ]
                                    },
                                    {
                                      "type": "text",
                                      "id": "POGVf",
                                      "x": 66,
                                      "y": 621,
                                      "name": "Page number",
                                      "fill": "$ink-muted",
                                      "textGrowth": "fixed-width",
                                      "width": 326,
                                      "content": "131",
                                      "textAlign": "center",
                                      "fontFamily": "$font-book",
                                      "fontSize": 10.2,
                                      "fontWeight": "normal"
                                    }
                                  ]
                                },
                                {
                                  "type": "frame",
                                  "id": "z3jtwI",
                                  "name": "Page 132 (verso)",
                                  "clip": true,
                                  "width": 440,
                                  "height": 660,
                                  "fill": "$paper",
                                  "cornerRadius": "$radius-sm",
                                  "stroke": "$border",
                                  "strokeWidth": 1,
                                  "effect": {
                                    "type": "shadow",
                                    "shadowType": "outer",
                                    "color": "#14202F22",
                                    "offset": {
                                      "x": 0,
                                      "y": 2
                                    },
                                    "blur": 8
                                  },
                                  "layout": "none",
                                  "children": [
                                    {
                                      "type": "frame",
                                      "id": "Yth50",
                                      "x": 48,
                                      "y": 59,
                                      "name": "Text block",
                                      "clip": true,
                                      "width": 326,
                                      "height": 535,
                                      "layout": "vertical",
                                      "children": [
                                        {
                                          "type": "text",
                                          "id": "uhddN",
                                          "name": "Paragraph",
                                          "fill": "$ink",
                                          "textGrowth": "fixed-width",
                                          "width": "fill_container",
                                          "content": "its fruit, and the sound of it falling carried clear across the grass, so that she held quite still and counted, the way she had been taught to count between lightning and thunder, waiting to learn how far away the trouble was and whether it was coming nearer.",
                                          "lineHeight": 1.4,
                                          "textAlign": "justify",
                                          "fontFamily": "$font-book",
                                          "fontSize": 11.2,
                                          "fontWeight": "normal"
                                        },
                                        {
                                          "type": "text",
                                          "id": "umT8o",
                                          "name": "Scene break",
                                          "fill": "$ink-muted",
                                          "textGrowth": "fixed-width",
                                          "width": "fill_container",
                                          "content": "* * *",
                                          "lineHeight": 2.6,
                                          "textAlign": "center",
                                          "fontFamily": "$font-book",
                                          "fontSize": 11.2,
                                          "fontWeight": "normal"
                                        },
                                        {
                                          "type": "text",
                                          "id": "oVIF7",
                                          "name": "Paragraph",
                                          "fill": "$ink",
                                          "textGrowth": "fixed-width",
                                          "width": "fill_container",
                                          "content": "In the morning the salt came in off the water, and with it the smell of something older than the harbour.",
                                          "lineHeight": 1.4,
                                          "textAlign": "justify",
                                          "fontFamily": "$font-book",
                                          "fontSize": 11.2,
                                          "fontWeight": "normal"
                                        },
                                        {
                                          "type": "text",
                                          "id": "BDiWq",
                                          "name": "Paragraph",
                                          "fill": "$ink",
                                          "textGrowth": "fixed-width",
                                          "width": "fill_container",
                                          "content": "​　　 Ines had slept badly, and not only because the bed was narrow. Twice in the night she had woken to a sound like someone dragging a chair across the room above hers, and twice she had told herself that there was no room above hers.",
                                          "lineHeight": 1.4,
                                          "textAlign": "justify",
                                          "fontFamily": "$font-book",
                                          "fontSize": 11.2,
                                          "fontWeight": "normal"
                                        },
                                        {
                                          "type": "text",
                                          "id": "Xy2Jo",
                                          "name": "Paragraph",
                                          "fill": "$ink",
                                          "textGrowth": "fixed-width",
                                          "width": "fill_container",
                                          "content": "​　　 Downstairs her aunt was already at the stove, her back turned, her sleeves pushed to the elbow. She did not ask where Ines had been the afternoon before. She set a bowl of porridge on the table and a small blue jug of cream beside it, and then, after a moment, a single apple, which she placed very carefully at the edge of the cloth.",
                                          "lineHeight": 1.4,
                                          "textAlign": "justify",
                                          "fontFamily": "$font-book",
                                          "fontSize": 11.2,
                                          "fontWeight": "normal"
                                        },
                                        {
                                          "type": "text",
                                          "id": "mDmSJ",
                                          "name": "Paragraph",
                                          "fill": "$ink",
                                          "textGrowth": "fixed-width",
                                          "width": "fill_container",
                                          "content": "​　　 Neither of them looked at it. The kettle began to tick as it warmed, and outside the window a gull walked the length of the roof with its head cocked, listening for something under the slates. Ines ate slowly. She was aware of the apple the way one is aware of a person standing silently in a doorway, and when at last she picked it up, her aunt said, without turning round, that it was a good year for them, and that she should eat it where it was ripe. The gull dropped from the roof and was gone.",
                                          "lineHeight": 1.4,
                                          "textAlign": "justify",
                                          "fontFamily": "$font-book",
                                          "fontSize": 11.2,
                                          "fontWeight": "normal"
                                        }
                                      ]
                                    },
                                    {
                                      "type": "text",
                                      "id": "miYTj",
                                      "x": 48,
                                      "y": 25,
                                      "name": "Running head",
                                      "fill": "$ink-muted",
                                      "textGrowth": "fixed-width",
                                      "width": 326,
                                      "content": "THE SALT ORCHARD",
                                      "textAlign": "center",
                                      "fontFamily": "$font-book",
                                      "fontSize": 8.7,
                                      "fontWeight": "normal",
                                      "letterSpacing": 1.6
                                    },
                                    {
                                      "type": "text",
                                      "id": "mdCVM",
                                      "x": 48,
                                      "y": 621,
                                      "name": "Page number",
                                      "fill": "$ink-muted",
                                      "textGrowth": "fixed-width",
                                      "width": 326,
                                      "content": "132",
                                      "textAlign": "center",
                                      "fontFamily": "$font-book",
                                      "fontSize": 10.2,
                                      "fontWeight": "normal"
                                    }
                                  ]
                                }
                              ]
                            }
                          ]
                        },
