                                      "layout": "vertical",
                                      "children": [
                                        {
                                          "type": "frame",
                                          "id": "ILm4N",
                                          "name": "Chapter opening (sunk)",
                                          "width": "fill_container",
                                          "layout": "vertical",
                                          "gap": 10,
                                          "padding": [
                                            80,
