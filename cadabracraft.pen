                                      "layout": "vertical",
                                      "children": [
                                        {
                                          "type": "frame",
                                          "id": "Ynegf",
                                          "name": "Chapter opening (sunk)",
                                          "width": "fill_container",
                                          "layout": "vertical",
                                          "gap": 16,
