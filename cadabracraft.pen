                  "name": "CHAPTER SEVEN",
                  "fill": "$accent",
                  "content": "CHAPTER SEVEN",
                  "fontFamily": "$font-ui",
                  "fontSize": 11,
                  "fontWeight": "700",
                  "letterSpacing": 1.6
                },
                {
                  "type": "text",
                  "id": "b46Y2C",
                  "name": "The Orchard Wall",
                  "fill": "$ink",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "The Orchard Wall",
                  "fontFamily": "$font-book",
                  "fontSize": 32,
                  "fontWeight": "600"
                },
                {
                  "type": "text",
                  "id": "tmfIv",
                  "name": "By the time Ines reached",
                  "fill": "$ink",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "By the time Ines reached the wall, the apples had begun to fall, thudding into the long grass like small, unhurried knocks.",
                  "lineHeight": 1.75,
                  "fontFamily": "$font-book",
                  "fontSize": 18,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "WXGnj",
                  "name": "She had been told the or",
                  "fill": "$ink",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "She had been told the orchard belonged to no one. Nothing about the gate, rusted open and wound with bindweed, suggested otherwise. She pressed her palm to the stones and found them warm, as though the afternoon had been stored in them.",
                  "lineHeight": 1.75,
                  "fontFamily": "$font-book",
                  "fontSize": 18,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "STnLC",
                  "name": "* * *",
                  "fill": "$ink-muted",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "* * *",
                  "textAlign": "center",
                  "fontFamily": "$font-book",
                  "fontSize": 20,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "RkZUR",
                  "name": "In the morning the salt ",
                  "fill": "$ink",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "In the morning the salt came in off the water, and with it the smell of something older than the harbour. Ines woke to the sound of a ladder being dragged across gravel, and lay very still, counting the seconds between each scrape.",
                  "lineHeight": 1.75,
                  "fontFamily": "$font-book",
                  "fontSize": 18,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "sfkmM",
                  "name": "Somebody, it seemed, had",
                  "fill": "$ink",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Somebody, it seemed, had been told otherwise.",
                  "lineHeight": 1.75,
                  "fontFamily": "$font-book",
                  "fontSize": 18,
                  "fontWeight": "normal"
                }
              ]
            }
          ]
